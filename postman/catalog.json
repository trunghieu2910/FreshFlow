          }
        },
        {
          "name": "Filter Available Products Only",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products?availableOnly=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products"],
              "query": [
                {
                  "key": "availableOnly",
                  "value": "true",
                  "description": "Only return products with at least one available variant"
                }
              ]
            },
            "description": "Filters products currently available for purchase (excluding capacity exhausted items)."
          }
        },
        {
          "name": "Custom Pagination and Sorting",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Page size matches requested limit\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.size).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products?page=0&size=2&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products"],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Zero-based page index"
                },
                {
                  "key": "size",
                  "value": "2",
                  "description": "Page size limit"
                },
                {
                  "key": "sort",
                  "value": "name,asc",
                  "description": "Sort property and direction"
                }
              ]
            },
            "description": "Retrieves page 0 with size 2 sorted alphabetically by name."
          }
        },
        {
          "name": "Get Product Detail - Success 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns correct product ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(Number(pm.collectionVariables.get(\"productId\")));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products", "{{productId}}"]
            },
            "description": "Retrieves details of a specific product and its variants."
          }
        },
        {
          "name": "Get Product Detail - Not Found 404 (Error Case)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Error response code is PRODUCT_NOT_FOUND\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(\"PRODUCT_NOT_FOUND\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products", "999999"]
            },
            "description": "Attempts to fetch a non-existent product ID, expecting 404."
          }
        }
      ]
    },
    {
      "name": "02 - Merchant Product Management",
      "description": "Endpoints used by merchant store owners to manage products.",
      "item": [
        {
          "name": "Create Product - Success 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Location header is present\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{merchantUserId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeCategoryId\": 1,\n  \"name\": \"Trà Sen Vàng Kem Cheese\",\n  \"description\": \"Trà sen thơm ngát kết hợp hạt sen bùi bùi và lớp kem cheese béo mịn\",\n  \"imageUrl\": \"https://images.freshflow.vn/products/tra-sen-vang.jpg\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/stores/{{storeId}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchant", "stores", "{{storeId}}", "products"]
            },
            "description": "Creates a new product under merchant's store."
          }
        },
        {
          "name": "Create Product - Validation Error 400 (Error Case)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Error code is VALIDATION_ERROR\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(\"VALIDATION_ERROR\");",
                  "    pm.expect(jsonData.fieldErrors.length).to.be.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{merchantUserId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"description\": \"Missing store category and blank name\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/stores/{{storeId}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchant", "stores", "{{storeId}}", "products"]
            },
            "description": "Tests field validation failure by sending empty required fields."
          }
        },
        {
          "name": "Create Product - Access Denied 403 (Error Case)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Error code indicates forbidden access\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.include(\"ACCESS_DENIED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "99999"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeCategoryId\": 1,\n  \"name\": \"Trà Xanh Thái Lan\",\n  \"description\": \"Trà thái đỏ\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/stores/{{storeId}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchant", "stores", "{{storeId}}", "products"]
            },
            "description": "Tests ownership check failure when actor user does not own the store."
          }
        },
        {
          "name": "Update Product - Success 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Updated name is reflected in response\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.name).to.eql(\"Trà Sữa Oolong Đặc Biệt\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{merchantUserId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Trà Sữa Oolong Đặc Biệt\",\n  \"description\": \"Công thức mới thơm ngon hơn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/stores/{{storeId}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchant", "stores", "{{storeId}}", "products", "{{productId}}"]
            },
            "description": "Updates product details."
          }
        },
        {
          "name": "Delete Product - Success 204",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204 No Content\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{merchantUserId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/stores/{{storeId}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchant", "stores", "{{storeId}}", "products", "{{productId}}"]
            },
            "description": "Soft-deletes product by deactivating it in the catalog."
          }
        }
      ]
    },
