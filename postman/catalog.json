                  "description": "Variant size for standard/single-size items (null size)"
                }
              ]
            },
            "description": "Filters products having standard/single-size variants."
          }
        },
        {
          "name": "Filter Products by Inventory Mode (MADE_TO_ORDER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products?inventoryMode=MADE_TO_ORDER",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products"],
