{
  "info": {
    "_postman_id": "freshflow-catalog-api-collection-v2",
    "name": "FreshFlow - Catalog API Collection",
    "description": "Comprehensive Postman collection for the FreshFlow Catalog module. Demonstrates the complete End-to-End Vertical Slice: Seed -> List -> Create -> Update -> Filter -> Delete, along with Customer public browsing, capacity status, and business error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "storeId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "variantId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "merchantUserId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "demoProductId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "demoVariantId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "demoProductName",
      "value": "Demo Lotus Tea",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Public Catalog (Browsing Seed Data)",
      "description": "Customer browsing endpoints: stores list, default pagination, keyword search, filters by category/size/stock/availability, and product details.",
      "item": [
        {
          "name": "1.1 - List Active Stores",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array of active stores\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "    pm.expect(jsonData.length).to.be.greaterThan(0);",
                  "    var store = jsonData.find(function(s) { return s.name === 'FreshFlow Demo Kitchen'; });",
                  "    pm.expect(store).to.not.be.undefined;",
                  "    pm.collectionVariables.set(\"storeId\", String(store.id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores"]
            },
            "description": "Retrieves all active stores available for customer orders."
          }
        },
        {
          "name": "1.2 - List Store Products - Default Pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Contains pagination metadata and seed products >= 30\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"content\");",
                  "    pm.expect(jsonData).to.have.property(\"totalElements\");",
                  "    pm.expect(jsonData.totalElements).to.be.at.least(30);",
                  "    pm.expect(jsonData.content).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Products have variants populated with capacity status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var firstProduct = jsonData.content[0];",
                  "    pm.expect(firstProduct).to.have.property(\"variants\");",
                  "    pm.expect(firstProduct.variants).to.be.an(\"array\");",
                  "    pm.collectionVariables.set(\"productId\", String(firstProduct.id));",
                  "    if (firstProduct.variants.length > 0) {",
                  "        pm.collectionVariables.set(\"variantId\", String(firstProduct.variants[0].id));",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products"]
            },
            "description": "Lists active products of the given store with default pagination (size=20, sort=name,asc)."
          }
        },
        {
          "name": "1.3 - Search Products by Keyword (Tea)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Matching products contain keyword in name or description\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.be.an(\"array\");",
                  "    pm.expect(jsonData.content.length).to.be.greaterThan(0);",
                  "    var allMatch = jsonData.content.every(function(p) {",
                  "        var text = (p.name + ' ' + (p.description || '')).toLowerCase();",
                  "        return text.includes('tea');",
                  "    });",
                  "    pm.expect(allMatch).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products?search=Tea",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products"],
              "query": [
                {
                  "key": "search",
                  "value": "Tea",
                  "description": "Keyword to match against product name, description, or variant"
                }
              ]
            },
            "description": "Searches store products containing the term 'Tea'."
          }
        },
        {
          "name": "1.4 - Filter Products by Category (Beverages)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns products under category\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.be.an(\"array\");",
                  "    pm.expect(jsonData.content.length).to.be.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products?storeCategoryId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products"],
              "query": [
                {
                  "key": "storeCategoryId",
                  "value": "1",
                  "description": "Filter by store category ID"
                }
              ]
            },
            "description": "Filters products under store category 1 (Beverages)."
          }
        },
        {
          "name": "1.5 - Filter Products by Variant Size (M)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns products with size M variant\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.be.an(\"array\");",
                  "    pm.expect(jsonData.content.length).to.be.greaterThan(0);",
                  "    var hasClassicMilkTea = jsonData.content.some(function(p) { return p.name === 'Classic Milk Tea'; });",
                  "    pm.expect(hasClassicMilkTea).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products?size=M",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products"],
              "query": [
                {
                  "key": "size",
                  "value": "M",
                  "description": "Filter by variant size"
                }
              ]
            },
            "description": "Filters sized products having variant size M."
          }
        },
        {
          "name": "1.6 - Filter Products by Variant Size (STANDARD)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns unsized standard products\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.be.an(\"array\");",
                  "    pm.expect(jsonData.content.length).to.be.greaterThan(0);",
                  "    var hasCroissant = jsonData.content.some(function(p) { return p.name === 'Butter Croissant'; });",
                  "    pm.expect(hasCroissant).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products?size=STANDARD",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products"],
              "query": [
                {
                  "key": "size",
                  "value": "STANDARD",
                  "description": "Filter by STANDARD variant"
                }
              ]
            },
            "description": "Filters unsized bakery/dessert products having STANDARD variant."
          }
        },
        {
          "name": "1.7 - Filter Products by Inventory Mode (MADE_TO_ORDER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns MADE_TO_ORDER products\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.be.an(\"array\");",
                  "    pm.expect(jsonData.content.length).to.be.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products?inventoryMode=MADE_TO_ORDER",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products"],
              "query": [
                {
                  "key": "inventoryMode",
                  "value": "MADE_TO_ORDER",
                  "description": "Filter by inventory mode"
                }
              ]
            },
            "description": "Filters products that are freshly prepared upon order."
          }
        },
        {
          "name": "1.8 - Filter Available Products Only",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All returned products have available status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.be.an(\"array\");",
                  "    pm.expect(jsonData.content.length).to.be.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products?availableOnly=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products"],
              "query": [
                {
                  "key": "availableOnly",
                  "value": "true",
                  "description": "Match only products having available variants"
                }
              ]
            },
            "description": "Filters products currently available for purchase."
          }
        },
        {
          "name": "1.9 - Custom Pagination and Sorting",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Page size is 5 and content has exactly 5 items\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content.length).to.eql(5);",
                  "    pm.expect(jsonData.size).to.eql(5);",
                  "    pm.expect(jsonData.number).to.eql(0);",
                  "    pm.expect(jsonData.totalPages).to.be.at.least(6);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products?page=0&size=5&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products"],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Zero-based page index"
                },
                {
                  "key": "size",
                  "value": "5",
                  "description": "Page size"
                },
                {
                  "key": "sort",
                  "value": "name,asc",
                  "description": "Sort property and direction"
                }
              ]
            },
            "description": "Tests custom page size and alphabetical name sorting."
          }
        },
        {
          "name": "1.10 - Get Product Detail - Success 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Product ID matches and has valid fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(Number(pm.collectionVariables.get(\"productId\")));",
                  "    pm.expect(jsonData).to.have.property(\"name\");",
                  "    pm.expect(jsonData).to.have.property(\"variants\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products", "{{productId}}"]
            },
            "description": "Retrieves product detail with variants and availability."
          }
        },
        {
          "name": "1.11 - Get Product Detail - Not Found 404 (Error Case)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Returns CATALOG_PRODUCT_NOT_FOUND error code\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(\"CATALOG_PRODUCT_NOT_FOUND\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/products/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "products", "999999"]
            },
            "description": "Tests product not found error response."
          }
        }
      ]
    },
    {
      "name": "02 - Vertical Slice Lifecycle (Create -> Update -> Filter -> Delete)",
      "description": "End-to-End Vertical Slice: Merchant creates a new product and variant, updates details, Customer filters and verifies, then Merchant deletes (soft-delete) and Customer confirms exclusion.",
      "item": [
        {
          "name": "2.1 - Merchant Create Product - Success 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var timestamp = new Date().getTime();",
                  "pm.collectionVariables.set(\"demoProductName\", \"Demo Lotus Tea \" + timestamp);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Location header is present and ID is captured\", function () {",
                  "    var location = pm.response.headers.get(\"Location\");",
                  "    pm.expect(location).to.be.a(\"string\");",
                  "    var segments = location.split(\"/\");",
                  "    var newId = segments[segments.length - 1];",
                  "    pm.collectionVariables.set(\"demoProductId\", newId);",
                  "});",
                  "pm.test(\"Response body contains created product\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.name).to.eql(pm.collectionVariables.get(\"demoProductName\"));",
                  "    pm.expect(jsonData.active).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{merchantUserId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeCategoryId\": 1,\n  \"name\": \"{{demoProductName}}\",\n  \"description\": \"Fragrant lotus seed tea with rich salted cream cheese foam\",\n  \"imageUrl\": \"https://images.freshflow.local/products/lotus-tea.jpg\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/stores/{{storeId}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchant", "stores", "{{storeId}}", "products"]
            },
            "description": "Merchant creates a brand new product under FreshFlow Demo Kitchen."
          }
        },
        {
          "name": "2.2 - Merchant Create Variant - Success 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response contains created variant ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "    pm.expect(jsonData.price).to.eql(45000.0);",
                  "    pm.collectionVariables.set(\"demoVariantId\", String(jsonData.id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{merchantUserId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"M\",\n  \"size\": \"M\",\n  \"price\": 45000.00,\n  \"inventoryMode\": \"MADE_TO_ORDER\",\n  \"autoAcceptOverride\": true,\n  \"maxQuantityPerOrder\": 10,\n  \"dailyCapacityDefault\": 120,\n  \"available\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/stores/{{storeId}}/products/{{demoProductId}}/variants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchant", "stores", "{{storeId}}", "products", "{{demoProductId}}", "variants"]
            },
            "description": "Creates a size M variant for the newly created product."
          }
        },
        {
          "name": "2.3 - Merchant List Variants - Success 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns variants of the newly created product\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "    pm.expect(jsonData.length).to.be.greaterThan(0);",
                  "    var v = jsonData.find(function(item) { return item.name === 'M'; });",
                  "    pm.expect(v).to.not.be.undefined;",
                  "    pm.expect(v.price).to.eql(45000.0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{merchantUserId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/stores/{{storeId}}/products/{{demoProductId}}/variants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchant", "stores", "{{storeId}}", "products", "{{demoProductId}}", "variants"]
            },
            "description": "Merchant lists all variants of the newly created product."
          }
        },
        {
          "name": "2.4 - Merchant Update Variant - Success 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Updated price and capacity reflected\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.price).to.eql(48000.0);",
                  "    pm.expect(jsonData.dailyCapacityDefault).to.eql(150);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{merchantUserId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 48000.00,\n  \"dailyCapacityDefault\": 150\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/stores/{{storeId}}/products/{{demoProductId}}/variants/{{demoVariantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchant", "stores", "{{storeId}}", "products", "{{demoProductId}}", "variants", "{{demoVariantId}}"]
            },
            "description": "Merchant updates variant price and capacity."
          }
        },
        {
          "name": "2.5 - Merchant Update Product - Success 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
