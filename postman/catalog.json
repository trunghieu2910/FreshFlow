              "raw": "{\n  \"name\": \"Size L Lớn\",\n  \"size\": \"L\",\n  \"price\": 42000.00,\n  \"inventoryMode\": \"MADE_TO_ORDER\",\n  \"autoAcceptOverride\": true,\n  \"maxQuantityPerOrder\": 10,\n  \"dailyCapacityDefault\": 100,\n  \"available\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/stores/{{storeId}}/products/{{productId}}/variants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchant", "stores", "{{storeId}}", "products", "{{productId}}", "variants"]
            },
            "description": "Creates a new variant under a product."
          }
        },
        {
          "name": "Create Variant - Validation Error 400 (Error Case)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
